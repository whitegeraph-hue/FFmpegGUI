# Local binary package. Build the app image first, then run package-arch.py.
pkgname=ffmpeggui-linux
pkgver=0.1.0
pkgrel=1
pkgdesc='FFmpegGUI native desktop editor (development preview)'
arch=('x86_64')
url='https://github.com/whitegeraph-hue/FFmpegGUI'
license=('EUPL-1.2')
depends=('glibc' 'gcc-libs' 'ffmpeg' 'ttf-dejavu' 'espeak-ng' 'libx11' 'libxext' 'libxi' 'libxrender' 'libxtst' 'libglvnd' 'fontconfig' 'freetype2' 'alsa-lib' 'gtk3' 'zlib' 'hicolor-icon-theme')
options=('!strip' '!debug')
source=('app-image.tar.gz' 'LICENSE' 'ffmpeggui-linux.desktop' 'ffmpeggui-linux-launcher')
# Generated by package-arch.py from the local build, not unverified remote bytes.
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')
package() {
  install -dm755 "$pkgdir/opt" "$pkgdir/usr/share/licenses/$pkgname" "$pkgdir/usr/share/doc/$pkgname"
  cp -a --no-preserve=ownership "$srcdir/ffmpeggui-linux" "$pkgdir/opt/"
  install -Dm755 "$srcdir/ffmpeggui-linux-launcher" "$pkgdir/usr/bin/ffmpeggui-linux"
  install -Dm644 "$srcdir/ffmpeggui-linux.desktop" "$pkgdir/usr/share/applications/ffmpeggui-linux.desktop"
  install -Dm644 "$srcdir/ffmpeggui-linux/lib/ffmpeggui-linux.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/ffmpeggui-linux.png"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
